{
  "name": "printmart",
  "version": "1.0.0",
  "private": true,
  "description": "PrintKu - Toko ATK & Jasa Fotocopy Online",
  "scripts": {
    "install:all": "npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start:backend": "npm --prefix backend run start",
    "smoke": "npm --prefix backend run smoke"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}