# Server
PORT=8080
APP_ENV=development

# Database (SQLite - file lokal, ganti dengan PostgreSQL saat production)
DATABASE_PATH=./data/printmart.db
DB_BACKEND=sqlite

# Redis (opsional - jika tidak tersedia, otomatis fallback ke in-memory queue)
REDIS_ADDR=localhost:6379

# JWT
JWT_SECRET=ganti_dengan_secret_yang_kuat_printmart_2024
JWT_EXPIRES_IN=24h

# Payment Gateway (SANDBOX / TESTING MODE - simulasi lokal)
PAYMENT_PROVIDER=midtrans-sandbox
PAYMENT_IS_PRODUCTION=false

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# CORS (origin frontend)
CORS_ORIGIN=http://localhost:5173

# Admin default (dibuat saat seed pertama kali)
ADMIN_EMAIL=admin@printmart.local
ADMIN_PASSWORD=admin123