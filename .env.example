# PrintMart — konfigurasi root (dipakai oleh docker-compose & backend).
# Salin ke .env lalu sesuaikan. Untuk dev lokal backend, salin juga ke
# backend/.env (lihat backend/.env.example).

# ===== Server =====
PORT=8080
APP_ENV=development

# ===== Database (SQLite pure-Go, tidak perlu server DB terpisah) =====
DATABASE_PATH=./data/printmart.db

# ===== Redis (opsional; kosong/unreachable -> fallback antrian in-memory) =====
REDIS_ADDR=localhost:6379

# ===== JWT =====
JWT_SECRET=ganti_dengan_secret_yang_kuat_printmart_2024
JWT_EXPIRES_IN=24h

# ===== Payment (sandbox / simulasi lokal) =====
PAYMENT_PROVIDER=midtrans-sandbox
PAYMENT_IS_PRODUCTION=false

# ===== File upload =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ===== CORS (origin frontend) =====
CORS_ORIGIN=http://localhost:5173

# ===== Admin default (dibuat saat seed pertama) =====
ADMIN_EMAIL=admin@printmart.local
ADMIN_PASSWORD=admin123

# ===== Frontend (Docker Compose) =====
# URL backend yang dipakai proxy Vite di dalam jaringan compose.
BACKEND_URL=http://backend:8080
